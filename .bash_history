#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export DISPLAY=:1

xset s off 2>/dev/null
xset -dpms 2>/dev/null
xsetroot -solid "#2c3e50" 2>/dev/null &

xterm -geometry 85x28+20+20 -bg black -fg white -fa "Monospace" -fs 11 &

exec fluxbox
EOF

