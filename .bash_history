cat << 'EOF' > ~/.config/tigervnc/xstartup
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

exec python3 -c '
import os
try:
    g = os.getgid()
    u = os.getuid()
    os.setresgid(g, g, g)
    os.setresuid(u, u, u)
except Exception:
    pass
os.execlp("/bin/sh", "sh", "-c", "eval $(dbus-launch --sh-syntax 2>/dev/null); exec startxfce4")
'
EOF

chmod +x ~/.config/tigervnc/xstartup
